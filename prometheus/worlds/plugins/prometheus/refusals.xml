<?xml version="1.0" encoding="iso-8859-1"?>
<!DOCTYPE muclient>
<!-- Things you can't do (yet): wait timers, locked hatches, not enough of something. -->
<!-- The Lua for these triggers is in lua/prometheus/triggers/refusals.lua -->
<muclient>
<triggers>

<trigger
  enabled="y"
  match="^Wait (\d+) (seconds?|minutes?)\.$"
  regexp="y"
  sequence="100"
  script="Refusals_WaitSecondsMinutes"
></trigger>

<trigger
  enabled="y"
  match="No repair drones available."
  sequence="100"
  script="Refusals_NoRepairDronesAvailable"
></trigger>

<trigger
  enabled="y"
  match="Only owners can do this."
  sequence="100"
  script="Refusals_OnlyOwnersCanDoThis"
></trigger>

<trigger
  enabled="y"
  match="You can't * while *."
  sequence="100"
  script="Refusals_YouCanWhile"
></trigger>

<trigger
  enabled="y"
  match="You must wait another * while the * generator recharges."
  sequence="100"
  script="Refusals_YouMustWaitAnotherWhileThe"
></trigger>

<trigger
  enabled="y"
  match="Repair the * first."
  sequence="100"
  script="Refusals_RepairTheFirst"
></trigger>

<trigger
  enabled="y"
  match="The ship is already in the process of harvesting *."
  sequence="100"
  script="Refusals_TheShipIsAlreadyInThe"
></trigger>

<trigger
  enabled="y"
  match="You cannot teleport * a ship with active shields."
  sequence="100"
  script="Refusals_YouCannotTeleportAShipWith"
></trigger>

<trigger
  enabled="y"
  match="You cannot salvage while the ship is in motion."
  sequence="100"
  script="Refusals_YouCannotSalvageWhileTheShip"
></trigger>

<trigger
  enabled="y"
  match="The ship is currently unable to move."
  sequence="100"
  script="Refusals_TheShipIsCurrentlyUnableTo"
