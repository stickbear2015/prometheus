></trigger>

<trigger
  enabled="y"
  match="^([^\[].*) (remove|removes|unstrap|unstraps) (.*?)\.$"
  regexp="y"
  sequence="100"
  script="Refusals_RemoveRemovesUnstrapUnstraps"
></trigger>

<trigger
  enabled="y"
  match="The * banks are already full."
  sequence="100"
  script="Refusals_TheBanksAreAlreadyFull"
></trigger>

<trigger
  enabled="y"
  match="Due to the amount of energy drawn by the cloaking generator, you can not fire weapons while cloaked."
  sequence="100"
  script="Refusals_DueToTheAmountOfEnergy"
></trigger>

<trigger
  enabled="y"
  match="You already have that!"
  sequence="100"
  script="Refusals_YouAlreadyHaveThat"
></trigger>

<trigger
  enabled="y"
  match="The equipment is non-functional when damaged. Please repair it fully before proceeding."
  sequence="100"
