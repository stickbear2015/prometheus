></trigger>

<trigger
  enabled="y"
  match="The ship is already salvaging."
  sequence="100"
  script="Refusals_TheShipIsAlreadySalvaging"
></trigger>

<trigger
  enabled="y"
  match="The * is already firing."
  sequence="100"
  script="Refusals_TheIsAlreadyFiring"
></trigger>

<trigger
  enabled="y"
  match="&gt;&gt; Command Aborted &lt;&lt;"
  omit_from_output="y"
  sequence="100"
  script="Refusals_CommandAborted"
></trigger>

<trigger
  enabled="y"
  match="Buying less than one? Nice try!"
  sequence="100"
  script="Refusals_BuyingLessThanOneNiceTry"
></trigger>

<trigger
  enabled="y"
