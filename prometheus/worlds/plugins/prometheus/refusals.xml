></trigger>

<trigger
  enabled="y"
  match="The weapons are not powered up."
  sequence="100"
  script="Refusals_TheWeaponsAreNotPoweredUp"
></trigger>

<trigger
  enabled="y"
  match="You cannot deploy probes while the starship is moving."
  sequence="100"
  script="Refusals_YouCannotDeployProbesWhileThe"
></trigger>

<trigger
  enabled="y"
  match="You cannot salvage while landing."
  sequence="100"
  script="Refusals_YouCannotSalvageWhileLanding"
></trigger>

<trigger
  enabled="y"
  match="No shipwrecks found. Cannot continue grabbing process."
