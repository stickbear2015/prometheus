  sequence="100"
  script="Refusals_TheStarshipIsAlreadyOnAlert"
></trigger>

<trigger
  enabled="y"
  match="Those coordinates are too far away to establish a lock."
  sequence="100"
  script="Refusals_ThoseCoordinatesAreTooFarAway"
></trigger>

<trigger
  enabled="y"
  match="Those controls are already in use."
  sequence="100"
  script="Refusals_ThoseControlsAreAlreadyInUse"
></trigger>

<trigger
  enabled="y"
  match="Either the launchers do not need reloading, or the ship lacks the required ammunition."
  sequence="100"
