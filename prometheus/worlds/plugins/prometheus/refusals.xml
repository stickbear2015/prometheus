></trigger>

<trigger
  enabled="y"
  match="Hyperspace drive could not be activated due to the vessle being in motion."
  sequence="100"
  script="Refusals_HyperspaceDriveCouldNotBeActivated"
></trigger>

<trigger
  enabled="y"
  match="The sublight drive is still recharging: * remaining."
  sequence="100"
