></trigger>

<trigger
  enabled="y"
  match="You cannot grab any more."
  sequence="100"
  script="Refusals_YouCannotGrabAnyMore"
></trigger>

<trigger
  enabled="y"
  match="Excavation impossible due to damaged equipment."
  sequence="100"
  script="Refusals_ExcavationImpossibleDueToDamagedEquipment"
></trigger>

<trigger
  enabled="y"
  match="There are no destinations to which you can teleport at present."
  sequence="100"
  script="Refusals_ThereAreNoDestinationsToWhich"
></trigger>

<trigger
  enabled="y"
  match="You can't go that way."
  sequence="100"
  script="Refusals_YouCanGoThatWay"
></trigger>

<trigger
  enabled="y"
  match="*bump*into the locked door leading *."
  sequence="100"
  script="Refusals_BumpIntoTheLockedDoorLeading"
></trigger>

<trigger
  enabled="y"
  match="The * launchers are cooling down."
  omit_from_output="y"
  sequence="100"
  script="Refusals_TheLaunchersAreCoolingDown"
></trigger>

<trigger
  enabled="y"
  match="* are already being fired."
  sequence="100"
  script="Refusals_AreAlreadyBeingFired"
></trigger>

<trigger
  enabled="y"
  match="The LRL is recharging: * remaining."
  sequence="100"
