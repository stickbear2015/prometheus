></trigger>

<trigger
  enabled="y"
  match="There is not a star in the sector."
  sequence="100"
  script="Refusals_ThereIsNotAStarIn"
></trigger>

<trigger
  enabled="y"
  match="* should not be moving."
  sequence="100"
  script="Refusals_ShouldNotBeMoving"
></trigger>

<trigger
  enabled="y"
  match="You cannot use that in hyperspace."
