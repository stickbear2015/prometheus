></trigger>

<trigger
  enabled="y"
  match="Please deactivate * first."
  sequence="100"
  script="Refusals_PleaseDeactivateFirst"
></trigger>

<trigger
  enabled="y"
  match="The power controls of this ship are locked due to it being under construction."
  sequence="100"
