  sequence="100"
  script="Refusals_UnlockTheBeamFirst"
></trigger>

<trigger
  enabled="y"
  match="The starship's NAVI drive is already engaged."
  sequence="100"
  script="Refusals_TheStarshipNaviDriveIsAlready"
></trigger>

<trigger
  enabled="y"
  match="Please do not attempt to salvage while your ship is in the midst of probing a derelict starship."
  sequence="100"
  script="Refusals_PleaseDoNotAttemptToSalvage"
></trigger>

<trigger
  enabled="y"
  match="Wait for the acceleration to hyperspace first."
  sequence="100"
