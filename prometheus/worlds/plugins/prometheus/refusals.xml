  script="Refusals_TrToEnterButTurnedAway"
></trigger>

<trigger
  enabled="y"
  match="You hear somebody trying to enter the ship."
  sequence="100"
  script="Refusals_YouHearSomebodyTryingToEnter"
></trigger>

<trigger
  enabled="y"
  match="A weapon is already being repaired."
  sequence="100"
  script="Refusals_AWeaponIsAlreadyBeingRepaired"
></trigger>

<trigger
  enabled="y"
  match="You can't teleport for *."
  sequence="100"
  script="Refusals_YouCanTeleportFor"
></trigger>

<trigger
  enabled="y"
  match="* to autopilot first."
  sequence="100"
  script="Refusals_ToAutopilotFirst"
></trigger>

<trigger
  enabled="y"
  match="* to manual pilot first."
  sequence="100"
  script="Refusals_ToManualPilotFirst"
></trigger>

<trigger
  enabled="y"
  match="Hyperspace jumps cannot be aborted."
  sequence="100"
  script="Refusals_HyperspaceJumpsCannotBeAborted"
></trigger>

<trigger
  enabled="y"
  match="The * is already in that sector."
  sequence="100"
  script="Refusals_TheIsAlreadyInThatSector"
></trigger>

<trigger
  enabled="y"
  match="The * is not moving."
  sequence="100"
  script="Refusals_TheIsNotMoving"
></trigger>

<trigger
  enabled="y"
  match="The * is already moving."
  sequence="100"
  script="Refusals_TheIsAlreadyMoving"
></trigger>

<trigger
  enabled="y"
  match="You're already there."
  sequence="100"
  script="Refusals_YouReAlreadyThere"
></trigger>

<trigger
  enabled="y"
