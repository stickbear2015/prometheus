<?xml version="1.0" encoding="iso-8859-1"?>
<!DOCTYPE muclient>
<muclient>
<plugin name="Prometheus" author="Kendal Hamilton" id="ad8f25246eb08f268411d690"
language="Lua" purpose="Soundpack for Prometheus: The Eternal Wars."
requires="5.00">
<description trim="y">
<![CDATA[
Soundpack for Prometheus: The Eternal Wars. Developed by Kendal Hamilton. Originally created by Nyano Cooper, and kept going for years by Krinnzenn.
]]>
</description>
</plugin>
<include name="constants.lua"/>

<!-- The triggers are split into one file per area, in worlds/plugins/prometheus/.
     Their Lua is in lua/prometheus/triggers/. -->
<include name="prometheus/system.xml"/>
<include name="prometheus/comms.xml"/>
<include name="prometheus/starship.xml"/>
<include name="prometheus/combat.xml"/>
<include name="prometheus/activities.xml"/>
<include name="prometheus/devices.xml"/>
<include name="prometheus/vehicles.xml"/>
<include name="prometheus/socials.xml"/>
<include name="prometheus/general.xml"/>
<include name="prometheus/games.xml"/>
<include name="prometheus/items.xml"/>
<include name="prometheus/health.xml"/>
<include name="prometheus/groups.xml"/>
<include name="prometheus/money.xml"/>
<include name="prometheus/teleporting.xml"/>
<include name="prometheus/household.xml"/>
<include name="prometheus/game.xml"/>
<include name="prometheus/refusals.xml"/>
<include name="prometheus/gags.xml"/>

<aliases>
<alias match="ble *" enabled="y" ignore_case="y" sequence="100">
<send>block %1 on ear</send></alias>
<alias match="cloff" enabled="y" ignore_case="y" sequence="100">
<send>cloak off</send></alias>
<alias match="clon" enabled="y" ignore_case="y" sequence="100">
<send>cloak on</send></alias>
<alias match="cls" enabled="y" ignore_case="y" sequence="100">
<send>cloak status</send></alias>
<alias match="cpc" enabled="y" ignore_case="y" sequence="100">
<send>commpipe clear</send></alias>
<alias match="cpl" enabled="y" ignore_case="y" sequence="100">
<send>commpipe link</send></alias>
<alias match="cplk" enabled="y" ignore_case="y" sequence="100">
<send>commpipe linked</send></alias>
<alias match="cpoff" enabled="y" ignore_case="y" sequence="100">
<send>commpipe off</send></alias>
<alias match="cpon" enabled="y" ignore_case="y" sequence="100">
<send>commpipe on</send></alias>
<alias match="cpul" enabled="y" ignore_case="y" sequence="100">
<send>commpipe unlink</send></alias>
<alias match="mch" enabled="y" ignore_case="y" sequence="100">
<send>mail check</send></alias>
<alias match="nvd" enabled="y" ignore_case="y" sequence="100">
<send>navi dest</send></alias>
<alias match="pmh" enabled="y" sequence="100">
<send>pm history</send></alias>
<alias match="pmr *" enabled="y" ignore_case="y" sequence="100">
<send>pm reply %1</send></alias>
<alias match="pmrl *" enabled="y" ignore_case="y" sequence="100">
<send>pm replylock %1</send></alias>
<alias match="rpl *" enabled="y" ignore_case="y" sequence="100">
<send>reply %1</send></alias>
<alias match="shc" enabled="y" ignore_case="y" sequence="100">
<send>shi cycle</send></alias>
<alias match="shch" enabled="y" ignore_case="y" sequence="100">
<send>shi charge</send></alias>
<alias match="shoff" enabled="y" ignore_case="y" sequence="100">
<send>shi off</send></alias>
<alias match="shon" enabled="y" ignore_case="y" sequence="100">
<send>shi on</send></alias>
<alias match="shs" enabled="y" ignore_case="y" sequence="100">
<send>shi status</send></alias>
<alias match="sht" enabled="y" sequence="100">
<send>shi time</send></alias>
<alias match="slk" enabled="y" sequence="100">
<send>slink</send></alias>
<alias match="snl" enabled="y" sequence="100">
<send>sunlink</send></alias>
<alias match="tf" enabled="y" ignore_case="y" sequence="100">
<send>transfer</send></alias>
<alias match="tlc" enabled="y" ignore_case="y" sequence="100">
<send>tr linkcount</send></alias>
<alias match="tpt" enabled="y" ignore_case="y" sequence="100">
<send>transport</send></alias>
<alias match="trl" enabled="y" ignore_case="y" sequence="100">
<send>tr links</send></alias>
<alias match="trlk *" enabled="y" ignore_case="y" sequence="100">
<send>tr link %1</send></alias>
<alias match="trs" enabled="y" ignore_case="y" sequence="100">
<send>tr sirens</send></alias>
<alias match="trt" enabled="y" ignore_case="y" sequence="100">
<send>tr track</send></alias>
<alias match="trul" enabled="y" ignore_case="y" sequence="100">
<send>tr unlink</send></alias>
<alias match="ube *" enabled="y" ignore_case="y" sequence="100">
<send>unblock %1 on ear</send></alias>

<alias match="aron" enabled="y" ignore_case="y" sequence="100">
<send>armor on</send></alias>
<alias match="aroff" enabled="y" ignore_case="y" sequence="100">
<send>armor off</send></alias>
<alias match="ars" enabled="y" ignore_case="y" sequence="100">
<send>armor status</send></alias>
<alias match="tsr" enabled="y" ignore_case="y" sequence="100">
<send>tar sni</send></alias>
<alias match="brc" enabled="y" ignore_case="y" sequence="100">
<send>breathe cre</send></alias>
<alias match="rblt" enabled="y" ignore_case="y" sequence="100">
<send>recharge belt with station</send></alias>
<alias match="gblt" enabled="y" ignore_case="y" sequence="100">
<send>get belt from station</send></alias>
<alias match="cblt" enabled="y" ignore_case="y" sequence="100">
<send>check belt</send></alias>
<alias match="rnan" enabled="y" ignore_case="y" sequence="100">
<send>recharge nan with station</send></alias>
<alias match="gnan" enabled="y" ignore_case="y" sequence="100">
<send>get nan from station</send></alias>
<alias match="rsj" enabled="y" ignore_case="y" sequence="100">
<send>recharge space with station</send></alias>
<alias match="gsj" enabled="y" ignore_case="y" sequence="100">
<send>get space from station</send></alias>
<alias match="csj" enabled="y" ignore_case="y" sequence="100">
<send>check space</send></alias>
<alias match="sts" enabled="y" ignore_case="y" sequence="100">
<send>check station</send></alias>
<alias match="stc" enabled="y" ignore_case="y" sequence="100">
<send>charge station</send></alias>

<alias match="^bat$" enabled="y" regexp="y" ignore_case="y" send_to="12" sequence="100">
<send>Execute("beaconadd transl")</send></alias>
<alias match="^(bpt|prod)$" enabled="y" regexp="y" ignore_case="y" send_to="12" sequence="100">
<send>Execute("prod transl")</send></alias>
<alias match="^brt$" regexp="y" enabled="y" ignore_case="y" send_to="12" sequence="100">
<send>Execute("beaconremove transl")</send></alias>
<alias match="^btt$" regexp="y" enabled="y" ignore_case="y" send_to="12" sequence="100">
<send>Execute("beaconto transl")</send></alias>
<alias match="^mkills$" omit_from_log="y" omit_from_output="y" regexp="y" enabled="y" ignore_case="y" send_to="12" sequence="100">
<send>
require("tprint")
if (mobsTable ~= nil) then
Note("The following mobs you have killed:")
Note(tprint(table.sort(mobsTable)))
else
Note("No mob kills recorded.")
end
</send></alias>
<alias match="^readme$" omit_from_log="y" omit_from_output="y" regexp="y" enabled="y" ignore_case="y" send_to="12" sequence="100">
<send>Execute("sphelp readme")</send></alias>
<alias match="^changelog$" omit_from_log="y" omit_from_output="y" regexp="y" enabled="y" ignore_case="y" send_to="12" sequence="100">
<send>Execute("sphelp changelog")</send></alias>
<alias match="^version$" omit_from_command_history="y" omit_from_log="y" omit_from_output="y" regexp="y" enabled="y" ignore_case="y" send_to="12" sequence="100">
<send>
-- local origin = Path.getmtime(Workspace.."version.info")
-- local date = os.date("%B %d, %Y", origin)
-- local days = RoundNumber((os.time(os.date("!*t")) - origin)) / 86400, 0)
Note("MUSHClient Soundpack Version: "..GetVariable("version")..".")
-- if (days > 1) then
-- Note("Released on "..date.." ("..tostring(days).." days ago).")
-- end
</send></alias>
<alias match="^dt$" regexp="y" enabled="y" ignore_case="y" send_to="12" sequence="100">
<send>Execute("deliver-time")</send></alias>
<alias name="ToggleSoundpackDebug" match="^spdebug(?:\s+(now))?$" enabled="y" group="debug"
  omit_from_command_history="y" omit_from_log="y" regexp="y" omit_from_output="y"
  ignore_case="y" script="SoundpackDebug_Alias" sequence="100">
  </alias>
<alias name="SoundpackUpdate" match="^spupdate$" enabled="y" group="updater"
  omit_from_command_history="y" omit_from_output="y" regexp="y"
  ignore_case="y" send_to="12" sequence="100">
  <send>Updater_Check(false)</send></alias>
<alias name="SoundpackTester" match="^sptester(?:\s+(.*))?$" enabled="y" group="updater"
  omit_from_command_history="y" omit_from_log="y" omit_from_output="y" regexp="y"
  ignore_case="y" script="Updater_TesterAlias" sequence="100">
  </alias>
<alias name="SoundpackWorkbench" match="^spworkbench(?:\s+(.*))?$" enabled="y" group="updater"
  omit_from_command_history="y" omit_from_log="y" omit_from_output="y" regexp="y"
  ignore_case="y" script="Updater_WorkbenchAlias" sequence="100">
  </alias>
<alias name="SoundpackReport" match="^spreport$" enabled="y" group="reports"
  omit_from_output="y" regexp="y"
  ignore_case="y" send_to="12" sequence="100">
  <send>Reports_Send()</send></alias>
<alias name="SoundpackReportAdd" match="^spreport add (\d+)$" enabled="y" group="reports"
  omit_from_output="y" regexp="y"
  ignore_case="y" script="Reports_AddAlias" sequence="100">
  </alias>
<alias name="SoundpackReports" match="^spreports$" enabled="y" group="reports"
  omit_from_output="y" regexp="y"
  ignore_case="y" send_to="12" sequence="100">
  <send>Reports_List()</send></alias>
</aliases>
<script><![CDATA[
-- Look for Lua modules in this copy of MUSHclient first, even if a separately
-- installed Lua has set LUA_PATH or LUA_CPATH (issue #51).
do
  local dir = GetInfo(66)
  package.path = dir .. "lua/?.lua;" .. dir .. "lua/?/init.lua;" .. package.path
  package.cpath = dir .. "?.dll;" .. dir .. "lua/?.dll;" .. package.cpath
end

require("prometheus.main")
Path = require("pl.path")
require("prometheus.util")

-- Trigger functions, one file per area (common.lua holds shared helpers).
require("prometheus.triggers.common")
require("prometheus.triggers.system")
require("prometheus.triggers.comms")
require("prometheus.triggers.starship")
require("prometheus.triggers.combat")
require("prometheus.triggers.activities")
require("prometheus.triggers.devices")
require("prometheus.triggers.vehicles")
require("prometheus.triggers.socials")
require("prometheus.triggers.general")
require("prometheus.triggers.games")
require("prometheus.triggers.items")
require("prometheus.triggers.health")
require("prometheus.triggers.groups")
require("prometheus.triggers.money")
require("prometheus.triggers.teleporting")
require("prometheus.triggers.household")
require("prometheus.triggers.game")
require("prometheus.triggers.refusals")
require("prometheus.triggers.gags")
require("prometheus.triggers.debug")  -- last: it wraps the functions above for spdebug

guns = {"pistol", "rifle", "shotgun", "sniper"}
]]></script>
</muclient>